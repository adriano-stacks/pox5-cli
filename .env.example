# pox5-cli configuration — copy to `.env` and adjust.
# These values are the default values for Stacks mainnet.
# Set a variable only when you must override its default value.

# --- Stacks ---
# Core-node RPC base (the SDK hits ${POX5_STACKS_API_URL}/v2/pox, /v2/accounts, /v2/contracts/call-read).
# NOTE: this is the host root, NOT the /extended path.
POX5_STACKS_API_URL=https://api.mainnet.hiro.so

# Hiro Extended API base — used for transaction/event queries and staker discovery.
POX5_EXTENDED_API_URL=https://api.mainnet.hiro.so/extended

# Stacks explorer base + chain for the clickable links emitted by `signers`.
# Links resolve to ${POX5_EXPLORER_URL}/address/<principal>?chain=${POX5_EXPLORER_CHAIN}&api=${POX5_STACKS_API_URL}
POX5_EXPLORER_URL=https://explorer.hiro.so
POX5_EXPLORER_CHAIN=mainnet

# Stacks mainnet chain id (0x00000001). Used when signing transactions.
POX5_CHAIN_ID=1

# pox-5 boot-contract deploy address (contract name is always `pox-5`).
POX5_BOOT_ADDRESS=SP000000000000000000002Q6VF78

# Address/tx-version base to clone from: testnet | mainnet | devnet.
POX5_NETWORK_BASE=mainnet

# Optional: set the first PoX-5 reward cycle if /v2/pox does not supply a
# pox-5 contract_version. Mainnet supplies cycle 141. Set this value to use
# bond and schedule calculations on a custom network.
# POX5_FIRST_POX5_CYCLE=

# --- Bitcoin ---
# Esplora-compatible API base (mempool.space-style). Note the trailing /api.
POX5_BITCOIN_API_URL=https://mempool.space/api

# --- Signing keys (not used by read-only commands; reserved for write flows) ---
# POX5_STX_PRIVATE_KEY=
# POX5_STX_ADDRESS=
# POX5_BTC_WIF=
# POX5_BTC_ADDRESS=
# Bond-admin signing key for `setup-bond`. Optional: if unset, setup-bond falls
# back to POX5_STX_PRIVATE_KEY. Whichever is used must control the on-chain
# bond-admin principal or the call is rejected with ERR_UNAUTHORIZED.
# POX5_BOND_ADMIN_PRIVATE_KEY=
# Signer key for `setup-signer` grants. Optional: if unset, setup-signer falls
# back to POX5_STX_PRIVATE_KEY. Its public key becomes the signer-manager's
# registered signer key.
# POX5_SIGNER_PRIVATE_KEY=
# sBTC deployer key for `faucet sbtc` on a development network.
# Do not use a production key with the faucet command.
# POX5_SBTC_DEPLOYER_PRIVATE_KEY=
