# pox5-cli configuration — copy to `.env` and adjust.
# All values below are the defaults baked into the CLI for the
# `testnet-pox5.hiro.so` PoX-5 testnet; you only need to set a
# variable here to override its default.

# --- Stacks ---
# Core-node RPC base (the SDK hits ${POX5_STACKS_API_URL}/v2/pox, /v2/accounts, /v2/contracts/call-read).
# NOTE: this is the host root, NOT the /extended path.
POX5_STACKS_API_URL=https://api.testnet-pox5.hiro.so

# Hiro Extended API base — used for the faucets and for `signers` staker discovery.
POX5_EXTENDED_API_URL=https://api.testnet-pox5.hiro.so/extended

# Stacks explorer base + chain for the clickable links emitted by `signers`.
# Links resolve to ${POX5_EXPLORER_URL}/address/<principal>?chain=${POX5_EXPLORER_CHAIN}&api=${POX5_STACKS_API_URL}
POX5_EXPLORER_URL=https://explorer.hiro.so
POX5_EXPLORER_CHAIN=mainnet

# Stacks chain id for this network (testnet-pox5 reports network_id 2147483653,
# i.e. 0x80000005). Used when signing txs.
POX5_CHAIN_ID=2147483653

# pox-5 boot-contract deploy address (contract name is always `pox-5`).
POX5_BOOT_ADDRESS=ST000000000000000000002AMW42H

# Address/tx-version base to clone from: testnet | mainnet | devnet.
POX5_NETWORK_BASE=testnet

# Optional: force the first PoX-5 reward cycle when /v2/pox doesn't advertise a
# pox-5 contract_version (then firstPox5RewardCycle() is undefined and bond-schedule
# derivation can't run). Set the cycle number to enable those commands.
# POX5_FIRST_POX5_CYCLE=

# --- Bitcoin ---
# Esplora-compatible API base (mempool.space-style). Note the trailing /api.
POX5_BITCOIN_API_URL=https://mempool.testnet-pox5.hiro.so/api

# --- Signing keys (not used by read-only commands; reserved for write flows) ---
# POX5_STX_PRIVATE_KEY=
# POX5_STX_ADDRESS=
# POX5_BTC_WIF=
# POX5_BTC_ADDRESS=
# Bond-admin signing key for `setup-bond`. Optional: if unset, setup-bond falls
# back to POX5_STX_PRIVATE_KEY. Whichever is used must control the on-chain
# bond-admin principal or the call is rejected with ERR_UNAUTHORIZED.
# POX5_BOND_ADMIN_PRIVATE_KEY=
# Signer key for `setup-signer` grants. Optional: if unset, setup-signer falls
# back to POX5_STX_PRIVATE_KEY. Its public key becomes the signer-manager's
# registered signer key.
# POX5_SIGNER_PRIVATE_KEY=
# sBTC deployer key for `faucet sbtc`. Optional: defaults to the public Clarinet
# wallet_8 key (ST3NBRSFKX28FQ2ZJ1MAKX58HKHSDGNV5N7R21XCP), which deployed the
# sbtc contracts on the old private-1 network. On testnet-pox5 the sbtc contracts
# live under the multisig SN3VMHXEN64ZZF71JQ5VESXDWTR301XTTXGF4J8F1, which this
# key does NOT control — set the actual deployer key here to use `faucet sbtc`.
# POX5_SBTC_DEPLOYER_PRIVATE_KEY=
