#!/usr/bin/env bash
# Convenience launcher: runs the CLI through tsx with Node provided by Nix,
# so you don't need node/pnpm on PATH. Usage: ./pox5 <command> [args]
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
exec nix shell nixpkgs#nodejs_latest --command "$here/node_modules/.bin/tsx" "$here/src/index.ts" "$@"
